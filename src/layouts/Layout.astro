---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  jsonLD?: Record<string, unknown>;
  pageType?: 'website' | 'software';
}

const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = '/og-image.png',
  jsonLD,
  pageType = 'website',
} = Astro.props;

const fullTitle = title.includes('FileLocker') ? title : `${title} — FileLocker`;
const ogImageAbsolute = new URL(ogImage, Astro.site).href;

// Base JSON-LD always present
const baseOrganizationLD = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://filelocker.online/#organization",
      "name": "FileLocker",
      "url": "https://filelocker.online",
      "logo": {
        "@type": "ImageObject",
        "url": "https://filelocker.online/logo/filelocker-logo-main.svg"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "support@filelocker.online"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://filelocker.online/#website",
      "url": "https://filelocker.online",
      "name": "FileLocker",
      "publisher": { "@id": "https://filelocker.online/#organization" }
    },
    ...(jsonLD ? [jsonLD] : [])
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-RG0JP0HT1R"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-RG0JP0HT1R');
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:type" content={pageType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:site_name" content="FileLocker" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageAbsolute} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/Favicon.png" />
  <link rel="apple-touch-icon" href="/Favicon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(baseOrganizationLD)} />
</head>
<body>
  <slot />
</body>
</html>
