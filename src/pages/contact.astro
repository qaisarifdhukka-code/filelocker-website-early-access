---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact FileLocker — Support and General Enquiries"
  description="Contact FileLocker for support, general enquiries, or partnership questions. We respond to all messages within 1–2 business days."
>
  <Navbar currentPath="/contact" />

  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow center">Contact</div>
      <h1>Get in touch.</h1>
      <p>Support, general questions, or feedback about FileLocker — we respond to all messages.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div style="display:grid;grid-template-columns:1fr 1.3fr;gap:56px;align-items:start;max-width:960px;margin:0 auto;">
        <div>
          <div class="eyebrow">Contact options</div>
          <div class="contact-options">
            <div class="contact-option">
              <h4>Product support</h4>
              <p>Trouble using FileLocker? Something not working as expected? Contact support and we'll help.</p>
              <p style="margin-top:10px;"><a href="mailto:support@filelocker.online" style="color:var(--color-navy);font-weight:600;">support@filelocker.online</a></p>
            </div>
            <div class="contact-option">
              <h4>Early Access</h4>
              <p>Questions about the Early Access program, waitlist, or expected launch timeline.</p>
              <p style="margin-top:10px;"><a href="/early-access" style="color:var(--color-navy);font-weight:600;">Request Access &rarr;</a></p>
            </div>
            <div class="contact-option">
              <h4>General enquiries</h4>
              <p>Partnership enquiries, press requests, or other questions about FileLocker.</p>
              <p style="margin-top:10px;"><a href="mailto:support@filelocker.online" style="color:var(--color-navy);font-weight:600;">support@filelocker.online</a></p>
            </div>
          </div>
        </div>

        <div>
          <div class="eyebrow">Send a message</div>
          <form id="contactForm" action="https://formspree.io/f/mrpzaopj" method="POST">
            <div class="form-field">
              <label for="contact-name">Name</label>
              <input type="text" id="contact-name" name="name" placeholder="Your name" required />
            </div>
            <div class="form-field">
              <label for="contact-email">Email</label>
              <input type="email" id="contact-email" name="email" placeholder="your@email.com" required />
            </div>
            <div class="form-field">
              <label for="contact-subject">Subject</label>
              <select id="contact-subject" name="subject">
                <option value="support">Product support</option>
                <option value="early-access">Early Access enquiry</option>
                <option value="general">General question</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-field">
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" placeholder="Describe your question or issue..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Send Message &rarr;</button>
            <p class="form-note">We respond to all messages within 1–2 business days.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    const form = document.getElementById('contactForm') as HTMLFormElement;
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalText = btn.innerHTML;
        btn.innerHTML = 'Sending...';
        // Add a tiny delay before disabling to prevent browser from cancelling
        setTimeout(() => {
          btn.disabled = true;
        }, 10);

        const formData = new FormData(form);
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });
          
          if (response.ok) {
            form.innerHTML = `
              <div style="text-align:center; padding: 32px 0;">
                <svg style="width:48px;height:48px;color:var(--color-primary);margin:0 auto 16px;display:block;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <h3 style="margin-bottom:8px;font-size:20px;">Message Sent</h3>
                <p style="color:var(--color-ink-soft);font-size:15px;">Thanks for reaching out! We'll get back to you shortly.</p>
              </div>
            `;
          } else {
            throw new Error('Formspree returned an error');
          }
        } catch (error) {
          btn.innerHTML = 'Error. Try again';
          btn.disabled = false;
        }
      });
    }
  </script>
</Layout>

<style>
  .contact-options { display: flex; flex-direction: column; gap: 16px; }
  .contact-option { border: 1px solid var(--color-line); border-radius: var(--radius-m); padding: 20px 22px; }
  .contact-option h4 { font-size: 15.5px; font-weight: 600; margin-bottom: 6px; }
  .contact-option p { font-size: 14px; color: var(--color-ink-soft); }
  @media (max-width: 860px) {
    div[style*="grid-template-columns:1fr 1.3fr"] { grid-template-columns: 1fr !important; }
  }
</style>
