---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="FileLocker Features — Everything Your Secure Delivery Workflow Needs"
  description="Explore all FileLocker features: AES-256-GCM encryption, custom branding, password generator, file name hiding, auto-delete, large file support, and zero-install recipient experience."
>
  <Navbar currentPath="/features" />

  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow center">Features</div>
      <h1>Everything you need to protect and deliver sensitive files.</h1>
      <p>FileLocker is built around the way professionals already work — with a simple workflow for protecting files before delivery.</p>
    </div>
  </section>

  <!-- FEATURES GRID -->
  <section>
    <div class="wrap">
      <div class="feature-grid">
        <div class="feature">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
          <h3>Your brand on the unlock screen</h3>
          <p>Display your firm's logo, name, and brand color on the recipient's unlock screen.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.6"><path d="M4 12a8 8 0 1 1 16 0 8 8 0 0 1-16 0Z"/><path d="M12 8v4l3 2"/></svg></div>
          <h3>No recipient installation</h3>
          <p>Recipients can open the locked file using a supported browser without installing FileLocker.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.6"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6Z"/></svg></div>
          <h3>Local processing</h3>
          <p>Protect files locally without requiring the original document to be uploaded to a FileLocker cloud service.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.6"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></div>
          <h3>Auto-delete original</h3>
          <p>Optionally remove the original unprotected file after locking completes.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.6"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/><line x1="1" y1="1" x2="23" y2="23"/></svg></div>
          <h3>Hide the original file name</h3>
          <p>Prevent the protected delivery from revealing the original document name.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3 9h18"/></svg></div>
          <h3>Protect files or folders</h3>
          <p>Protect an individual file or an entire folder in a single operation.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
          <h3>Password hints</h3>
          <p>Add an optional hint to help recipients remember their password.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="1.6"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
          <h3>Built-in password generator</h3>
          <p>Generate a strong random password instead of creating one manually.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- RECIPIENT EXPERIENCE -->
  <section class="section-alt">
    <div class="wrap">
      <div class="section-head center">
        <div class="eyebrow center">Recipient experience</div>
        <h2>Simple for your recipient. No installation required.</h2>
        <p>Your recipient receives the locked file, enters the password, chooses where to save the recovered file, and gets back to work.</p>
      </div>
      <div class="compare" style="max-width:800px;margin:0 auto;">
        <div class="compare-col without">
          <span class="compare-title">Traditional workflows</span>
          <ul>
            <li>May require additional software for encrypted archives</li>
            <li>May introduce account or sharing complexity</li>
            <li>Can require recipients to understand unfamiliar interfaces</li>
            <li>Cloud-based workflows may involve third-party storage</li>
            <li>More steps can mean more friction for non-technical recipients</li>
          </ul>
        </div>
        <div class="compare-col with">
          <span class="compare-title mono">FileLocker</span>
          <ul>
            <li>Open the locked file using a supported browser</li>
            <li>No FileLocker account for the recipient</li>
            <li>No FileLocker installation</li>
            <li>Simple password-based unlock</li>
            <li>Local browser-based recovery</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="wrap">
      <div class="final-cta">
        <h2>Ready to protect your first file?</h2>
        <p>FileLocker is currently available to selected professionals. Request access to get started.</p>
        <div class="hero-actions" style="justify-content:center;margin-bottom:18px;">
          <a href="/early-access" class="btn btn-primary">Request Access &rarr;</a>
          <a href="/how-it-works" class="btn btn-ghost">How It Works &rarr;</a>
        </div>
        <div class="note mono">WINDOWS 10 &amp; 11 &middot; ONE-TIME PURCHASE</div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
